        <CustomActions>
          <!--
            Adds the button to the Case main form command bar. The classic
            ribbon still renders on the modern model-driven command bar, and it
            is the only route that can be scripted end to end: the modern
            command-designer tables (appaction / appactionrule) are marked
            IsCustomizable=false and reject direct writes.
          -->
          <CustomAction Id="mjsrc.incident.Form.AgentPane.CustomAction" Location="Mscrm.Form.incident.MainTab.Save.Controls._children" Sequence="45">
            <CommandUIDefinition>
              <Button Id="mjsrc.incident.Form.AgentPane.Button" Command="mjsrc.incident.Form.AgentPane.Command" Sequence="45" LabelText="$LocLabels:mjsrc.incident.Form.AgentPane.Button.LabelText" ToolTipTitle="$LocLabels:mjsrc.incident.Form.AgentPane.Button.LabelText" ToolTipDescription="$LocLabels:mjsrc.incident.Form.AgentPane.Button.Description" TemplateAlias="o1" ModernImage="$webresource:mjsrc_/agent/agent-icon.svg" />
            </CommandUIDefinition>
